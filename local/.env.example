# Copy to local/.env (setup.sh does this). Everything here is optional.

# Default model access when a run doesn't pick one (the web form always picks):
#   claude_code → the local `claude` CLI on your Claude Code login, no API key
#   chatgpt     → the local `codex` CLI on your ChatGPT login, no API key
#   api         → API keys below
#   auto        → api if ANTHROPIC_API_KEY is set, otherwise claude_code
LLM_BACKEND=auto

# API mode only.
ANTHROPIC_API_KEY=
# Optional: OpenAI writes the subject-line options in API mode (CLI modes use their own model).
OPENAI_API_KEY=
# Optional: Gemini is a backup model for a few steps.
GOOGLE_API_KEY=

# CLI mode tuning:
# CLAUDE_CODE_MODEL=sonnet     # one Claude model for every step (default: opus for main steps)
# CHATGPT_MODEL=gpt-5.5        # default: `model` from ~/.codex/config.toml
# CODEX_BIN=/path/to/codex     # default: newest of PATH / ChatGPT.app / Codex.app
# CLI_LLM_CONCURRENCY=3        # parallel CLI processes

# Design each section with the tool-calling designer agent (renders, checks and revises
# its own section) instead of one model call per section. Slower, especially on CLI
# logins, where every agent turn is a CLI run. 0 turns it off.
# DESIGNER_AGENT=1
